import { cn } from "cn";
import Link from "next/link";
import type { ReactNode } from "react";

import { Container } from "@/components/ui/container";
import { Sections } from "@/components/ui/sections";
import { shopConfig } from "@/lib/config";
import { getMenu } from "@/lib/menu/server";
import { getShopPolicies } from "@/lib/policies/server";
import type { MenuItem } from "@/lib/shopify/transforms/menu/types";

import { Newsletter } from "./newsletter";
import { PaymentIcons } from "./payment-icons";
import { SocialLinks } from "./social-links";
import type { SocialLink } from "./social-links";

async function getFooterItems(): Promise<MenuItem[]> {
  try {
    const menu = await getMenu({ handle: "footer" });
    return menu?.items ?? [];
  } catch {
    return [];
  }
}

export async function Footer() {
  const socialLinks: SocialLink[] = [
    // TODO: replace these placeholder URLs with the real Ecombio accounts
    { platform: "instagram", url: "https://www.instagram.com/" },
    { platform: "tiktok", url: "https://www.tiktok.com/" },
    { platform: "youtube", url: "https://www.youtube.com/" },
    { platform: "linkedin", url: "https://www.linkedin.com/" },
  ];
  const items = await getFooterItems();
  const policies = await getShopPolicies({}).catch(() => []);
  const privacy = policies.find((policy) => policy.handle.includes("privacy"));
  const privacyHref = privacy ? `/policies/${privacy.handle}` : undefined;
  return (
    <footer>
      {/* pb-22 clears the fixed agent ActionBar pill when it renders */}
      <Container className={cn("pt-20 pb-10", shopConfig.agent.isEnabled && "pb-22")}>
        <Sections className="gap-10">
          <Newsletter privacyHref={privacyHref} />
          {items.length > 0 && <FooterMenu items={items} socialLinks={socialLinks} />}
          <div className="flex flex-col sm:flex-row items-center justify-between gap-5">
            <div className="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 sm:justify-start">
              <p className="text-sm text-muted-foreground leading-5">
                {`© ${shopConfig.site.name}. All rights reserved.`}
              </p>
              {policies.map((policy) => (
                <Link
                  key={policy.handle}
                  href={`/policies/${policy.handle}`}
                  className="cursor-pointer text-sm text-muted-foreground transition-colors hover:text-foreground"
                >
                  {policy.title}
                </Link>
              ))}
            </div>
          </div>
        </Sections>
      </Container>
    </footer>
  );
}

interface MenuLinkProps {
  children: ReactNode;
  className?: string;
  url: string;
}

function MenuLink({ url, children, className }: MenuLinkProps) {
  if (url.startsWith("http")) {
    return (
      <a href={url} target="_blank" rel="noopener noreferrer" className={className}>
        {children}
      </a>
    );
  }
  return (
    <Link href={url} className={className}>
      {children}
    </Link>
  );
}

function FooterMenu({
  items,
  socialLinks,
}: {
  items: MenuItem[];
  socialLinks: SocialLink[];
}) {
  const columns = items.slice(0, 5);
  const paymentsIndex = Math.min(2, columns.length - 1);

  return (
    <div className="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-10">
      {columns.map((column, index) => (
        <div key={column.id} className="space-y-3">
          {column.url ? (
            <MenuLink
              url={column.url}
              className="block text-base font-semibold hover:opacity-70 transition-opacity"
            >
              {column.title}
            </MenuLink>
          ) : (
            <h3 className="text-base font-semibold">{column.title}</h3>
          )}
          {column.items.length > 0 && (
            <ul className="space-y-2">
              {column.items.map((leaf) => (
                <li key={leaf.id}>
                  <MenuLink
                    url={leaf.url}
                    className="block text-sm text-foreground hover:opacity-70 transition-opacity"
                  >
                    {leaf.title}
                  </MenuLink>
                </li>
              ))}
            </ul>
          )}
          {index === 0 && socialLinks.length > 0 && <SocialLinks links={socialLinks} />}
          {index === paymentsIndex && <PaymentIcons />}
        </div>
      ))}
    </div>
  );
}