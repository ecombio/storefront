// C:\Users\Admin\Ecombio\storefront\tsconfig.json
{
  "compilerOptions": {
    "allowArbitraryExtensions": true,
    "allowJs": true,
    "esModuleInterop": true,
    "incremental": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "@/*": ["./*"],
      "@yotpo": ["./@yotpo/index.ts"],
      "@yotpo/*": ["./@yotpo/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2017"
  },
  "exclude": ["node_modules", "scripts", "tmp", ".eve", ".output", ".nitro", "dist"],
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "global.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ]
}
